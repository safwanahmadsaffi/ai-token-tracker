<odoo>
    <data noupdate="1">
        <record id="ir_cron_ai_usage_daily_reset" model="ir.cron">
            <field name="name">AI Usage: Daily Cleanup/Reset</field>
            <field name="model_id" ref="model_ai_usage_log"/>
            <field name="state">code</field>
            <field name="code">model.action_daily_reset()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d 00:00:00')"/>
        </record>

        <record id="seq_ai_usage_log" model="ir.sequence">
            <field name="name">AI Usage Log Sequence</field>
            <field name="code">ai.usage.log</field>
            <field name="prefix">AI/</field>
            <field name="padding">5</field>
        </record>
    </data>
</odoo>
